{
  "name": "herdr-upstash-box",
  "version": "0.1.0",
  "description": "Herdr plugin: run a coding agent in an Upstash Box from the worktree you are looking at",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upstash/herdr-upstash-box.git"
  },
  "homepage": "https://github.com/upstash/herdr-upstash-box#readme",
  "bugs": {
    "url": "https://github.com/upstash/herdr-upstash-box/issues"
  },
  "author": "Upstash, Inc.",
  "license": "MIT",
  "keywords": [
    "herdr",
    "herdr-plugin",
    "upstash",
    "box",
    "sandbox",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --write .",
    "ci:lint": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run ci:lint"
  },
  "dependencies": {
    "@upstash/box": "^0.7.5",
    "@upstash/box-cli": "^0.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.8.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  }
}
